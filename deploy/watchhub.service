# systemd 单元：把 WatchHub 跑成常驻服务
# 安装：
#   sudo mkdir -p /opt/watchhub && sudo cp -r server deploy /opt/watchhub/
#   sudo cp deploy/watchhub.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now watchhub
[Unit]
Description=WatchHub notification hub
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=watchhub
WorkingDirectory=/opt/watchhub
Environment=WATCHHUB_HOST=0.0.0.0
Environment=WATCHHUB_PORT=8787
Environment=WATCHHUB_DATA=/opt/watchhub/data
# 建议：WATCHHUB_TOKEN 从 EnvironmentFile 读取，别写进 unit
EnvironmentFile=-/opt/watchhub/.env
ExecStart=/usr/bin/python3 -m hub.main
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/watchhub/data

[Install]
WantedBy=multi-user.target
