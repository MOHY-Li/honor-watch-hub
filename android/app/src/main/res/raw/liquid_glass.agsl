// WatchHub 液体玻璃 —— AGSL (Android Graphics Shading Language)
//
// 参考 FlClash 的 shaders/liquid_glass.frag 思路，但为 Android RuntimeShader
// 重写（API 33+）。Flutter 的 Shader 和 AGSL 语法接近，都是 SkSL 家族。
//
// 核心思路：
//   1. 取当前画布背后的内容（RuntimeShader 的 inputShader 就是背景快照）
//   2. 在圆角矩形边缘做「折射」——越靠边，采样点越向中心偏移
//   3. 边缘加一圈亮度渐变的「边缘光」(rim)，模拟玻璃厚度反光
//   4. 叠加色散(dispersion)：RGB 三通道采样偏移量不同 → 真实玻璃的彩虹边
//   5. 整体做饱和度/亮度调整 + 一层薄雾(tint)
//
// uniform 布局（必须和 GlassShader.kt 里 setFloatUniform 的顺序一致）：
//   0-1   uSize          画布宽高
//   2     uRadius        圆角半径
//   3     uRefraction    折射强度（px）
//   4     uBevel         斜切深度（px）
//   5     uRim           边缘光强度
//   6     uRimWidth      边缘光宽度（px）
//   7     uSaturation    饱和度
//   8     uBrightness    亮度
//   9     uDispersion    色散强度
//   10    uBlur          模糊半径（采样抖动）
//   11-14 uTint          tint 颜色 rgba

uniform shader uBackdrop;
uniform float2 uSize;
uniform float  uRadius;
uniform float  uRefraction;
uniform float  uBevel;
uniform float  uRim;
uniform float  uRimWidth;
uniform float  uSaturation;
uniform float  uBrightness;
uniform float  uDispersion;
uniform float  uBlur;
uniform float4 uTint;
uniform float  uHairline;

// 圆角矩形的有符号距离场，返回值 < 0 表示在内部
float sdRoundRect(float2 p, float2 halfSize, float radius) {
    float2 q = abs(p) - halfSize + radius;
    return min(max(q.x, q.y), 0.0) + length(max(q, 0.0)) - radius;
}

// 亮度感知的饱和度调整
float3 saturate3(float3 c, float s) {
    float l = dot(c, float3(0.2126, 0.7152, 0.0722));
    return mix(float3(l), c, s);
}

float4 main(float2 coord) {
    float2 halfSize = uSize * 0.5;
    float2 p = coord - halfSize;

    float d = sdRoundRect(p, halfSize, uRadius);

    // 距离边缘的归一化距离：0 在边缘，1 在中心（按 bevel 深度归一）
    float edge = clamp(-d / max(uBevel, 0.001), 0.0, 1.0);

    // ---- 折射 ----
    // 越靠近边缘，采样点越向中心偏移（模拟光线穿过厚玻璃弯曲）
    // 用 smoothstep 做出「边缘陡、中心平」的曲线
    float bend = (1.0 - smoothstep(0.0, 1.0, edge));
    bend = bend * bend;                       // 平方让边缘更锐利

    float2 dir = halfSize - abs(p);
    float2 n = normalize(sign(p) * max(dir, 0.001) + 0.0001);
    float2 offset = -n * (bend * uRefraction);

    // ---- 色散 ----
    // RGB 用略微不同的折射率 → 边缘出现彩虹色
    float2 dispScale = float2(1.0 - uDispersion * 0.01, 1.0 + uDispersion * 0.01);
    float2 cR = coord + offset * dispScale.x;
    float2 cG = coord + offset;
    float2 cB = coord + offset * dispScale.y;

    // ---- 模糊 ----
    // 4 点抖动采样做廉价模糊（AGSL 里不方便做多 pass）
    float3 col;
    if (uBlur > 0.01) {
        float3 acc = float3(0.0);
        float2 o = float2(uBlur, 0.0);
        float2 o2 = float2(0.0, uBlur);
        acc += uBackdrop.eval(cR).rgb;
        acc += uBackdrop.eval(cR + o).rgb;
        acc += uBackdrop.eval(cR - o).rgb;
        acc += uBackdrop.eval(cR + o2).rgb;
        acc += uBackdrop.eval(cR - o2).rgb;
        col = acc / 5.0;
    } else {
        col = float3(
            uBackdrop.eval(cR).r,
            uBackdrop.eval(cG).g,
            uBackdrop.eval(cB).b
        );
    }

    // ---- 色调 ----
    col = saturate3(col, uSaturation) * uBrightness;
    col = mix(col, uTint.rgb, uTint.a);

    // ---- 边缘光 (rim) ----
    // 一条沿边缘亮起来、向内快速衰减的带子，模拟玻璃边缘的厚度反光
    float rimBand = 1.0 - smoothstep(0.0, max(uRimWidth, 0.001), -d);
    // 让光偏向顶部（模拟来自上方的环境光）
    float topLight = 0.5 + 0.5 * (-p.y / max(halfSize.y, 0.001));
    col += float3(uRim * rimBand * (0.35 + 0.65 * topLight));

    // ---- 发丝线 (hairline) ----
    // 极细的一圈暗线，让玻璃边界更清晰
    float hair = 1.0 - smoothstep(0.0, 1.2, abs(d + 0.6));
    col = mix(col, float3(0.0), hair * uHairline * 0.35);

    // 圆角外完全透明（用 SDF 做抗锯齿）
    float alpha = 1.0 - smoothstep(-1.0, 0.5, d);
    return float4(col, alpha);
}
